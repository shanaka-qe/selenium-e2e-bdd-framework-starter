# GitHub Actions workflow for CI/CD test execution
# This workflow runs automated tests on push and pull requests

name: Automated Test Execution

# Trigger conditions for workflow execution
on:
  # Run on push to main and develop branches
  push:
    branches:
      - main
      - develop
  
  # Run on pull requests to main branch
  pull_request:
    branches:
      - main
  
  # Allow manual workflow execution
  workflow_dispatch:

# Define workflow jobs
jobs:
  # Job for running automated tests
  test:
    # Run on Ubuntu latest version
    runs-on: ubuntu-latest
    
    # Define job steps
    steps:
      # Step 1: Checkout repository code
      - name: Checkout code
        uses: actions/checkout@v4
      
      # Step 2: Set up Java Development Kit
      - name: Set up JDK 11
        uses: actions/setup-java@v4
        with:
          java-version: '11'
          distribution: 'temurin'
          cache: 'maven'
      
      # Step 3: Install Chrome browser for tests
      - name: Install Chrome
        uses: browser-actions/setup-chrome@v1
        with:
          chrome-version: stable
      
      # Step 4: Verify Maven installation
      - name: Verify Maven
        run: mvn --version
      
      # Step 5: Clean and compile the project
      - name: Clean and compile
        run: mvn clean compile
      
      # Step 6: Run integration tests
      - name: Run tests
        run: mvn verify -Dwebdriver.driver=chrome
        continue-on-error: false
      
      # Step 7: Generate Serenity reports
      - name: Generate Serenity report
        if: always()
        run: mvn serenity:aggregate
      
      # Step 8: Upload test reports as artifacts
      - name: Upload test reports
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: test-reports
          path: |
            target/site/serenity/
            target/cucumber-reports.html
            target/cucumber-reports.json
          retention-days: 30
      
      # Step 9: Upload screenshots on failure
      - name: Upload screenshots
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: test-screenshots
          path: target/site/serenity/screenshots/
          retention-days: 30
      
      # Step 10: Publish test results summary
      - name: Publish test results
        if: always()
        uses: dorny/test-reporter@v1
        with:
          name: Test Results
          path: target/cucumber-reports.xml
          reporter: java-junit
          fail-on-error: false

# Concurrency control - cancel previous runs on new push
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

