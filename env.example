# Environment Configuration Template
# Copy this file to .env and update with your actual values
# Note: .env file is git-ignored for security

# ==========================================
# APPLICATION URLs
# ==========================================
APP_BASE_URL=https://www.saucedemo.com
APP_DEV_URL=https://dev.saucedemo.com
APP_STAGING_URL=https://staging.saucedemo.com
APP_PROD_URL=https://www.saucedemo.com

# API Endpoints (if applicable)
API_BASE_URL=https://api.saucedemo.com
API_DEV_URL=https://api-dev.saucedemo.com
API_STAGING_URL=https://api-staging.saucedemo.com

# ==========================================
# BROWSER CONFIGURATION
# ==========================================
BROWSER=chrome
# Options: chrome, firefox, edge
HEADLESS=false
MAXIMIZE_WINDOW=true

# ==========================================
# TIMEOUT CONFIGURATION (in seconds)
# ==========================================
IMPLICIT_WAIT=10
PAGE_LOAD_TIMEOUT=30
SCRIPT_TIMEOUT=30
EXPLICIT_WAIT=15

# ==========================================
# TEST EXECUTION CONFIGURATION
# ==========================================
PARALLEL_EXECUTION=false
THREAD_COUNT=1
RETRY_FAILED_TESTS=1

# ==========================================
# REPORTING CONFIGURATION
# ==========================================
GENERATE_REPORTS=true
TAKE_SCREENSHOTS=FOR_FAILURES
# Options: FOR_EACH_ACTION, FOR_FAILURES, DISABLED
STORE_HTML_SOURCE=true

# ==========================================
# ENVIRONMENT SELECTION
# ==========================================
ENVIRONMENT=dev
# Options: dev, staging, prod

# ==========================================
# CI/CD MODE
# ==========================================
CI_MODE=false
# Set to true when running in CI/CD pipeline

# ==========================================
# TEST DATA CONFIGURATION
# ==========================================
TEST_DATA_PATH=src/test/resources/testdata
CLEANUP_TEST_DATA=true

# ==========================================
# LOGGING CONFIGURATION
# ==========================================
LOG_LEVEL=INFO
# Options: TRACE, DEBUG, INFO, WARN, ERROR
LOG_TO_FILE=true
LOG_FILE_PATH=target/logs/test-execution.log

# ==========================================
# AUTHENTICATION (if needed)
# ==========================================
# TEST_USERNAME=standard_user
# TEST_PASSWORD=secret_sauce
# API_KEY=your_api_key_here
# API_TOKEN=your_api_token_here

# ==========================================
# DATABASE CONFIGURATION (if needed)
# ==========================================
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=testdb
# DB_USERNAME=testuser
# DB_PASSWORD=testpass

# ==========================================
# SLACK/EMAIL NOTIFICATIONS (if needed)
# ==========================================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# EMAIL_NOTIFICATIONS=false
# EMAIL_RECIPIENTS=team@example.com

# ==========================================
# CUSTOM CONFIGURATION
# ==========================================
# Add your custom configuration here

