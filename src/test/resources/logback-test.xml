<?xml version="1.0" encoding="UTF-8"?>
<!-- Logback configuration for test logging -->
<configuration>
    <!-- Console appender for outputting logs to console -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Pattern for log output: timestamp, thread, level, logger name, message -->
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File appender for saving logs to file -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>target/logs/test-execution.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger configuration -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- Framework-specific logging levels -->
    <logger name="com.automation" level="DEBUG"/>
    <logger name="net.serenitybdd" level="INFO"/>
    <logger name="org.openqa.selenium" level="INFO"/>
</configuration>

